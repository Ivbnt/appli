# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en .env : seules les lignes ACCOUNTS et APP_PASSWORD sont obligatoires.
# Tout le reste est facultatif (valeurs par défaut adaptées).
# .env n'est jamais envoyé sur GitHub.
# ─────────────────────────────────────────────────────────────

# Les deux comptes autorisés : Prénom Nom <adresse e-mail>, séparés par une virgule.
# Aucune autre adresse n'a accès.
ACCOUNTS="Prénom Nom <premiere@exemple.fr>, Prénom Nom <seconde@exemple.fr>"

# Mot de passe commun aux deux comptes, à saisir avec son adresse pour se connecter.
APP_PASSWORD=changez-moi


# ── Facultatif ────────────────────────────────────────────────

# URL de l'application et fuseau horaire.
# APP_URL=http://localhost:3000
# APP_TIMEZONE=Europe/Paris
# Port utilisé sur votre machine par Docker Compose.
# APP_PORT=3000

# Développement hors Docker uniquement (sous Docker, la base est configurée automatiquement).
# DATABASE_URL=postgresql://appli:appli@localhost:5432/appli
# AUTH_SECRET=   (sous Docker, généré automatiquement ; sinon : openssl rand -base64 48)

# Taille maximale d'une photo importée (Mo).
# MAX_UPLOAD_MB=25

# E-mails de rappel et de nouvelles du partenaire. Désactivés par défaut :
# sans service d'envoi (smtp ou resend), aucun e-mail ne part et ils sont seulement
# écrits dans les journaux. Voir la section « E-mail » du README pour les activer.
# EMAIL_PROVIDER=console
# EMAIL_FROM=
# SMTP_URL=
# EMAIL_API_KEY=

# Spotify (https://developer.spotify.com/dashboard) — Redirect URI : <APP_URL>/api/spotify/callback
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Films : clé API ou jeton de lecture TMDB (https://www.themoviedb.org/settings/api)
# MOVIE_API_KEY=

# Stockage des fichiers : local (disque, par défaut) ou s3 (AWS S3, Cloudflare R2, Scaleway, MinIO…)
# STORAGE_DRIVER=local
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_FORCE_PATH_STYLE=true

# Cartes : sans clé, fonds CARTO et recherche OpenStreetMap (gratuits).
# Avec une clé MapTiler (https://cloud.maptiler.com), fonds et géocodage MapTiler.
# MAP_API_KEY=
# GEOCODING_USER_AGENT=
