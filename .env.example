# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en .env puis adaptez les valeurs.
# Ne mettez JAMAIS de vraies clés dans Git (.env est ignoré).
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (liens dans les e-mails, retour OAuth Spotify).
APP_URL=http://localhost:3000
# Fuseau horaire utilisé pour l'affichage et les rappels.
APP_TIMEZONE=Europe/Paris

# Base de données PostgreSQL.
# Avec Docker Compose, DATABASE_URL est construite automatiquement à partir de ces trois variables.
POSTGRES_USER=appli
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=appli
# En développement hors Docker :
DATABASE_URL=postgresql://appli:changez-moi@localhost:5432/appli

# Secret de chiffrement et de signature (sessions, URLs de fichiers, jetons OAuth).
# Générez-le avec : openssl rand -base64 48
# Laissé vide sous Docker, un secret est généré automatiquement et conservé dans un volume.
AUTH_SECRET=

# Les deux comptes autorisés (il n'y a pas d'inscription). Ils sont créés automatiquement,
# déjà réunis dans le même espace. Chacun choisit son mot de passe via « Première connexion »
# sur la page de connexion : un lien arrive par e-mail.
# Format : Prénom Nom <adresse>, Prénom Nom <adresse>
ACCOUNTS="Prénom Nom <premiere@exemple.fr>, Prénom Nom <seconde@exemple.fr>"
# Taille maximale d'une photo importée (Mo).
MAX_UPLOAD_MB=25

# E-mails (première connexion, mots de passe oubliés, rappels, nouvelles du partenaire) :
# console (développement : affichés dans les logs, rien n'est envoyé), smtp ou resend.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=
# Uniquement avec EMAIL_PROVIDER=smtp. Avec Gmail (mot de passe d'application, voir le README) :
#   SMTP_URL=smtps://votre.adresse%40gmail.com:motdepassedapplication@smtp.gmail.com:465
#   EMAIL_FROM="Nous <votre.adresse@gmail.com>"
SMTP_URL=

# Spotify (https://developer.spotify.com/dashboard) — Redirect URI : <APP_URL>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Films : clé API ou jeton de lecture TMDB (https://www.themoviedb.org/settings/api)
MOVIE_API_KEY=

# Stockage des fichiers : local (disque) ou s3 (AWS S3, Cloudflare R2, Scaleway, MinIO…)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Cartes : facultatif. Sans clé, fonds CARTO et recherche OpenStreetMap (gratuits).
# Avec une clé MapTiler (https://cloud.maptiler.com), fonds et géocodage MapTiler.
MAP_API_KEY=
# Identifiant envoyé à OpenStreetMap/Nominatim (recommandé : une adresse de contact).
GEOCODING_USER_AGENT=
